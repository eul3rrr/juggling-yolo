+    "MIXED_3+": (170, 68, 255),
+    "MIXED_3+_UNCONFIRMED": (170, 68, 255),
+    "TWO_BALL": (255, 136, 68),
+    "SINGLE_BALL": (255, 220, 136),
+    "NO_BALL": (128, 128, 128),
+}
+
+
+def load_classifications(stem: str) -> dict:
+    """{frame: {v2: pattern, v4: pattern, v5: pattern}}"""
+    out = {}
+    for ver in ("v2", "v4", "v5"):
