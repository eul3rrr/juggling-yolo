+    frames = [r["frame"] for r in results]
+    patterns = [r["pattern"] for r in results]
+    confs = [r["confidence"] for r in results]
+    n_total = [r["n_total"] for r in results]
+
+    # Pattern color map
+    pattern_colors = {
+        "NO_BALL": "#888888",
+        "SINGLE_BALL": "#88ddff",
+        "TWO_BALL": "#4488ff",
+        "TWO_BALL_HELD": "#224488",
+        "TWO_BALL_ONE_HAND": "#aa44ff",
+        "CASCADE_3+": "#00ff44",
+        "FOUNTAIN_3+": "#ffaa00",
+        "MIXED_3+": "#ff44aa",
+        "MIXED_3+_UNCONFIRMED": "#ff44aa",
+        "CASCADE_3+_UNCONFIRMED": "#88ff88",
+        "UNKNOWN": "#444444",
+    }
+
+    fig, axes = plt.subplots(3, 1, figsize=(18, 8), sharex=True,
