+        font = ImageFont.load_default()
+        title_font = font
+    draw.text((margin, 8), title, fill="black", font=title_font)
+    for i, f in enumerate(frames[:n_rows * n_cols]):
+        r = i // n_cols
+        c = i % n_cols
+        x = margin + c * (sw + margin)
