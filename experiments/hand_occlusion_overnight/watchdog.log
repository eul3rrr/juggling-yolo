+    with (H1_DATA / f"h7v3pure_admitted_edges_{stem}.csv").open() as fh:
+        for r in csv.DictReader(fh):
+            r["from_tid"] = int(r["from_tid"])
+            r["to_tid"] = int(r["to_tid"])
