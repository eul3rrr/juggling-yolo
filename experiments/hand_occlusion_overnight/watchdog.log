+            r["last_frame"] = int(r["last_frame"])
+            r["tids"] = [int(t) for t in r["tids"].split(",") if t]
+            out.append(r)
+    return out
+
+
+def load_edges(stem: str, prefix: str = "h7v3veto") -> list[dict]:
