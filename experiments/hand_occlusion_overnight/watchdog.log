+                lconf = float(r.get("lw_conf", 0))
+                rconf = float(r.get("rw_conf", 0))
+                out[fr] = {
+                    "left": (lx, ly, lconf),
+                    "right": (rx, ry, rconf),
+                }
+            except (ValueError, KeyError):
+                continue
+    return out
