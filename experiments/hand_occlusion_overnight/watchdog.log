+    cluster_dets_in_reach,
+)
+
+H13_V2_STRICT = {
+    "MIN_CLUSTER_DETECTIONS": 3,
+    "MAX_CLUSTER_SPAN_FRAMES": 60,
+    "MAX_GAP_IN_CLUSTER": 12,
+    "STATIONARY_RADIUS_PX": 30,
+    "STATIONARY_MAX_STD_PX": 15,   # tighter than H3 v3's 30
