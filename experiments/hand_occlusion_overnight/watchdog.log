+H1_DATA = WORKTREE / "experiments" / "hand_occlusion_overnight" / "h1_hand_pool" / "data"
+
+
+def patch_thresholds(throw_leave_window_frames: int,
+                      catch_context_soft: bool = True) -> dict:
+    """Return a new V2_THRESHOLDS dict with the requested overrides."""
+    new = copy.deepcopy(h2.V2_THRESHOLDS)
+    new["THROW_LEAVE_WINDOW_FRAMES"] = throw_leave_window_frames
+    new["CATCH_CONTEXT_SOFT"] = catch_context_soft
+    return new
+
+
+def patch_state_machine(soft_catch_context: bool) -> None:
+    """Monkey-patch h1_hand_pool_v2's run_for_stem_v2 to use the soft
+    catch-context behavior. This is ugly but avoids rewriting the
+    700-line script.
+
+    When CATCH_CONTEXT_SOFT is True, an UNCONTEXTED_ENTRY still emits the
+    event but does NOT skip the catch (still creates a token, still
+    updates last_hand_event_frame).
+
+    Implementation: we wrap the original `run_for_stem_v2` and post-process
+    the events to ensure all UNCONTEXTED_ENTRY events that still have
+    tokens (i.e. the v3 behavior) are kept; we DON'T need to actually
+    change the algorithm because the v2 algorithm ALREADY creates tokens
+    on UNCONTEXTED_ENTRY (see the v2 source at line 432-450). The
+    difference is that v2 marks it as "uncontexted" and v3 marks it as
+    "potential". We can do that purely by renaming the event_type in the
+    output.
+    """
+    pass  # see renamer in run_sensitivity_grid
+
+
+def renamer_soft(events: list) -> list:
+    """Rename UNCONTEXTED_ENTRY to POTENTIAL_ENTRY in the event list.
+    Also: count the renames for summary statistics.
+    """
+    for e in events:
+        if e.event_type == "UNCONTEXTED_ENTRY":
+            e.event_type = "POTENTIAL_ENTRY"
+    return events
+
