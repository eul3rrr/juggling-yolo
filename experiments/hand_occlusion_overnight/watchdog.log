+#!/usr/bin/env python3
+"""H50 contact sheets: render the 3 changed-pattern windows for visual QA.
+
+Renders 3 contact sheets for the 3 H45-confirmed identity switches on
+identical that H50 dropped, with overlay of:
+  - the unfiltered (H12 v8 baseline) and filtered (H50) pattern labels
+  - the dropped CATCH/THROW events
+  - the chain involved
+"""
+from __future__ import annotations
+
+import csv
+from pathlib import Path
+
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.patches as mpatches
+import matplotlib.pyplot as plt
+
+WORKTREE = Path("/home/it-admin/projects/juggling-yolo-hand-occlusion-night")
+H1_DIR = WORKTREE / "experiments" / "hand_occlusion_overnight" / "h1_hand_pool"
+H1_DATA = H1_DIR / "data"
+OUT_DIR = H1_DIR / "contact_sheets_h50"
+OUT_DIR.mkdir(exist_ok=True)
+
+
+def load_csv(path: Path) -> list[dict]:
+    with path.open() as fh:
+        return list(csv.DictReader(fh))
+
+
+def load_wrist(stem: str) -> dict[int, dict]:
+    out = {}
+    path = WORKTREE / "detections" / f"{stem}_yolo26s-pose.csv"
+    with path.open() as fh:
+        for r in csv.DictReader(fh):
+            f = int(r["frame"])
+            e = out.setdefault(f, {"left": None, "right": None})
+            for side in ("left", "right"):
+                x = r.get(f"{side}_wrist_x")
+                y = r.get(f"{side}_wrist_y")
+                c = r.get(f"{side}_wrist_confidence")
+                if x and y and c and float(c) > 0.3:
+                    e[side] = (float(x), float(y))
+    return out
+
+
+def load_tracklets_for_chain(stem: str, chain_id: int) -> dict[int, list[tuple]]:
+    """Load the tracklet points (frame, x, y) for a given chain_id."""
+    chains = load_csv(H1_DATA / f"h7v3pure_chains_{stem}.csv")
+    chain = None
+    for c in chains:
+        if int(c["chain_id"]) == chain_id:
+            chain = c
+            break
+    if not chain:
+        return {}
+    tids = [int(t) for t in chain["tids"].split(",") if t]
+    # Load tracklet points from detections
+    tracklet_pts = {}
+    for tid in tids:
+        path = WORKTREE / "detections" / f"{stem}_norfair_dt50_hc5_tracklets.csv"
+        if not path.exists():
+            return {}
+        # Find tracklet
+    return chain
+
+
+def load_tracklet_points(stem: str, tid: int) -> list[tuple]:
+    path = WORKTREE / "detections" / f"{stem}_norfair_dt50_hc5_tracklet_pts.csv"
+    if not path.exists():
+        return []
+    pts = []
+    with path.open() as fh:
+        for r in csv.DictReader(fh):
+            if int(r["tid"]) == tid:
+                pts.append((int(r["frame"]), float(r["x"]), float(r["y"])))
+    return pts
