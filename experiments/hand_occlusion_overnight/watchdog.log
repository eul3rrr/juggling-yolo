+            r["n_h3_confirmed"] = int(r["n_h3_confirmed"])
+            out.append(r)
+    return out
+
+
+def load_h237_edges(stem: str) -> list[dict]:
+    edges = []
+    with (H1_DATA / f"h237_unified_edges_{stem}.csv").open() as fh:
+        for r in csv.DictReader(fh):
+            edges.append({
+                "from_tid": int(r["from_tid"]),
+                "to_tid": int(r["to_tid"]),
+                "edge_type": r["edge_type"],
+            })
+    return edges
+
+
