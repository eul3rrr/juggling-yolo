t_ascending'] == 'True') n_h30_pass = sum(1 for r in matching if r['h30_pass'] == 'True') n_combo = sum(1 for r in matching if r['both_above'] == 'True' or (r['src_above'] == 'True' and r['src_descending'] == 'True') or (r['tgt_above'] == 'True' and r['tgt_ascending'] == 'True')) print(f' {label} (n={n}): both_above={n_both_above}, src_above+desc={n_src_above_desc}, tgt_above+asc={n_tgt_above_asc}, h30_pass={n_h30_pass}, combo={n_combo}') print() print('Pool-wide check (n_both_above = total / 151):') n_both_above_pool = sum(1 for r in h30_dedup if r['both_above'] == 'True') n_src_above_desc_pool = sum(1 for r in h30_dedup if r['src_above'] == 'True' and r['src_descending'] == 'True') n_tgt_above_asc_pool = sum(1 for r in h30_dedup if r['tgt_above'] == 'True' and r['tgt_ascending'] == 'True') print(f' both_above: {n_both_above_pool} ({(n_both_above_pool/len(h30_dedup))*100:.1f}%)') print(f' src_above+desc: {n_src_above_desc_pool} ({(n_src_above_desc_pool/len(h30_dedup))*100:.1f}%)') print(f' tgt_above+asc: {n_tgt_above_asc_pool} ({(n_tgt_above_asc_pool/len(h30_dedup))*100:.1f}%)') "  0.2s

