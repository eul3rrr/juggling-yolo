+        ax.add_patch(Rectangle((r["frame"], 0), 1, 1, color=c, alpha=0.85))
+    ax.set_xlim(frames[0], frames[-1] + 1)
+    ax.set_ylim(0, 1)
+    ax.set_yticks([])
+    ax.set_title(f"{stem}: per-frame juggling pattern (H12 v2)")
+    # legend
+    legend_handles = [Rectangle((0, 0), 1, 1, color=pattern_colors[p], alpha=0.85)
+                       for p in sorted(set(patterns))]
+    ax.legend(legend_handles, sorted(set(patterns)),
+               loc="upper right", fontsize=8, ncol=3)
