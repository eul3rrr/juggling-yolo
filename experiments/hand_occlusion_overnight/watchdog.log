+    print(f'\n=== {stem} ===')
+    cnt_class = Counter()
+    cnt_conf_bucket = Counter()
+    n_sports_ball = 0
+    n_low_conf_sb = 0
+    n_v_low_conf_sb = 0
+    n_high_conf_sb = 0
+    max_frame = 0
+    sports_ball_examples = []
+    with open(p) as fh:
+        for r in csv.DictReader(fh):
+            cnt_class[r['class_name']] += 1
+            cf = float(r['confidence'])
+            bucket = round(cf, 1)
+            cnt_conf_bucket[bucket] += 1
+            max_frame = max(max_frame, int(r['frame']))
+            if r['class_name'] == 'sports ball':
+                n_sports_ball += 1
+                if cf < 0.5:
+                    n_low_conf_sb += 1
+                if cf < 0.2:
+                    n_v_low_conf_sb += 1
+                if cf >= 0.5:
+                    n_high_conf_sb += 1
+                if len(sports_ball_examples) < 5:
+                    sports_ball_examples.append((r['frame'], cf, r['center_x'], r['center_y']))
+    print(f'  max frame: {max_frame}')
+    print(f'  classes: {cnt_class.most_common(8)}')
