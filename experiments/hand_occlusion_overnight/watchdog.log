t_dets src_vrad = radial_velocity_toward_hand(stem, src_last3, expected_hand) tgt_vrad = radial_velocity_toward_hand(stem, tgt_first3, expected_hand) src_vy = (src_last3[-1][2] - src_last3[0][2]) / max(1, src_last3[-1][0] - src_last3[0][0]) tgt_vy = (tgt_first3[-1][2] - tgt_first3[0][2]) / max(1, tgt_first3[-1][0] - tgt_first3[0][0]) print(f' {src_tid}->{tgt_tid} ({stem[:6]}... hand={expected_hand}):') sv = f'{src_vrad:+.2f}' if src_vrad is not None else 'n/a' tv = f'{tgt_vrad:+.2f}' if tgt_vrad is not None else 'n/a' print(f' src_vrad_toward_hand={sv} tgt_vrad_toward_hand={tv}') print(f' src_vy={src_vy:+.2f} tgt_vy={tgt_vy:+.2f}') if src_vrad is not None and tgt_vrad is not None: if src_vrad and tgt_vrad kind = "CATCH+THROW (src approaching, tgt receding)" elif src_vrad and tgt_vrad kind = "BOTH APPROACHING (hand-borne or FP)" elif src_vrad and tgt_vrad kind = "BOTH RECEDING (carry-away or FP)" else: kind = "MIXED/UNCLEAR" print(f' -> {kind}') print('=== IDENTICAL BALLISTIC V-RECLASSIFIED EDGES ===') analyze('identical_balls_trick_000_018', 23, 25, 'right') analyze('identical_balls_trick_000_018', 30, 33, 'left') analyze('identical_balls_trick_000_018', 39, 47, 'left') analyze('identical_balls_trick_000_018', 51, 52, 'left') print() print('=== YOUTUBE BALLISTIC V-RECLASSIFIED EDGES ===') analyze('youtube_juggling_for_data_analysis_eh1I3SlZn48_075_090', 27, 28, 'left') PY  0.2s

