+    W = img_w * n_cols + pad * 3
+    sheet = np.full((H, W, 3), 255, dtype=np.uint8)
+
+    for row, f in enumerate(LATE_FRAMES):
+        cap.set(cv2.CAP_PROP_POS_FRAMES, f)
+        ok, frame = cap.read()
