# Python environments, caches, and tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local models and source media
*.pt
videos/*
!videos/.gitkeep

# Generated videos and review clips; keep compact review manifests.
outputs/*
!outputs/.gitkeep
!outputs/stitch_review/
!outputs/stitch_review/*/
!outputs/stitch_review/*/*.csv
!outputs/stitch_review/*/*.json
outputs/stitch_review/**/*.mp4

# Regenerable experiment media and local overnight-run state
experiments/**/STOP
experiments/**/watchdog.log
experiments/**/.watchdog.lock/
experiments/**/reports/**/*.mp4
experiments/overnight/data/legacy_csv/
experiments/overnight/data/e8/*.csv

