# Keep this repository intentionally minimal.
*
!.gitignore
!README.md
!scripts/
scripts/*
!scripts/detect_video.py
!scripts/track_video.py
!scripts/track_norfair.py
!scripts/stitch_tracklets.py
!scripts/review_stitches.py
!scripts/analyze_stitch_features.py
!configs/
configs/*
!configs/bytetrack.yaml
!configs/botsort.yaml
!configs/botsort_reid.yaml
!videos/
videos/*
!videos/.gitkeep
!outputs/
outputs/*
!outputs/.gitkeep
!outputs/stitch_review/
!outputs/stitch_review/*/
!outputs/stitch_review/*/*.csv
!outputs/stitch_review/*/*.json
!detections/
detections/*
!detections/.gitkeep
!detections/*.csv
!detections/*.json
!detections/*.md
*.pt
.venv/
tests/
!tests/
!tests/test_stitch_tracklets.py
!tests/test_review_stitches.py
!tests/test_analyze_stitch_features.py
!experiments/
experiments/*
!experiments/hand_occlusion_overnight/
experiments/hand_occlusion_overnight/*
!experiments/hand_occlusion_overnight/*.md
!experiments/hand_occlusion_overnight/*.sh
!experiments/hand_occlusion_overnight/*.log
!experiments/hand_occlusion_overnight/*.pid
!experiments/hand_occlusion_overnight/*.txt
!experiments/hand_occlusion_overnight/.gitkeep
!experiments/hand_occlusion_overnight/*/
# depth-2 files (one subdir under the lab dir)
!experiments/hand_occlusion_overnight/*/*.md
!experiments/hand_occlusion_overnight/*/*.sh
!experiments/hand_occlusion_overnight/*/*.py
!experiments/hand_occlusion_overnight/*/*.csv
!experiments/hand_occlusion_overnight/*/*.json
!experiments/hand_occlusion_overnight/*/*.png
!experiments/hand_occlusion_overnight/*/*.txt
!experiments/hand_occlusion_overnight/*/*.log
!experiments/hand_occlusion_overnight/*/
# depth-3 files (e.g. h1_hand_pool/scripts/foo.py)
!experiments/hand_occlusion_overnight/*/*/*.md
!experiments/hand_occlusion_overnight/*/*/*.sh
!experiments/hand_occlusion_overnight/*/*/*.py
!experiments/hand_occlusion_overnight/*/*/*.csv
!experiments/hand_occlusion_overnight/*/*/*.json
!experiments/hand_occlusion_overnight/*/*/*.png
!experiments/hand_occlusion_overnight/*/*/*.txt
