# Python environments, caches, and tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local models and source media (videos may show people; never commit them)
*.pt
videos/*
!videos/.gitkeep
/clip.mp4
/clip.mp4.csv

# Datasets are their own private repository
/datasets/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Generated output: everything under outputs/ is regenerable. The exceptions are
# small review manifests and the images the reports link to.
outputs/*
!outputs/.gitkeep
!outputs/stitch_review/
outputs/stitch_review/**/*.mp4
!outputs/track_event_review/
outputs/track_event_review/*
!outputs/track_event_review/manifest.csv
!outputs/detector_seg_comparison/
outputs/detector_seg_comparison/**/*.mp4

# Local-only folders
/archive/
/experiments/

